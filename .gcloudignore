# ==============================================================================
# Backend .gcloudignore (capstone_be)
# Excludes local .env, .venv, and caches while keeping tests/, evals/, and uv.lock
# for Cloud Build Step 2 (uv sync --dev && uv run pytest -v --cov).
# ==============================================================================

.gcloudignore
.DS_Store
.git/
.venv/
__pycache__/
*.py[oc]
.pytest_cache/
.coverage
.env
*.env
scope.md
docs/
