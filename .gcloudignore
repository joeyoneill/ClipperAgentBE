# ==============================================================================
# Backend .gcloudignore (capstone_be)
# Excludes local .env, .venv, corp-proxy uv.lock, and caches while keeping tests/ and evals/
# for Cloud Build Step 2 (uv sync --dev && uv run pytest -v --cov).
# ==============================================================================

.gcloudignore
.DS_Store
.git/
.venv/
uv.lock
__pycache__/
*.py[oc]
.pytest_cache/
.coverage
.env
*.env
scope.md
docs/
